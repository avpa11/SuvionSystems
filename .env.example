# Local demo defaults. Copy to .env; never commit real keys.
NEXT_PUBLIC_API_HOST=http://localhost:4001
HOST=127.0.0.1
PORT=4001
MONGO_URI=mongodb://127.0.0.1:27017/suvion
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
NMEA_HOST=127.0.0.1
NMEA_PORT=10110
DEFAULT_FUEL_TYPE=diesel
VESSEL_ID=DEMO-VESSEL-001
# Optional Signal K bridge. Use one fuel source at a time to avoid double ingestion.
SIGNALK_ENABLED=false
SIGNALK_URL=ws://localhost:3000/signalk/v1/stream
# Docker simulator scenario: cruising | anchoring | generator_cycling
SIM_SCENARIO=cruising
# Maximum time a report holds a sample before treating the feed as missing.
REPORT_MAX_SAMPLE_AGE_SECONDS=300
# External services are optional. Keys stay in the API, never NEXT_PUBLIC_*.
VALIDATION_AGENT_ENABLED=false
REALTIME_AGENT_ENABLED=false
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
OPENWEATHER_API_KEY=
ANOMALY_DETECTION_ENABLED=false
ANOMALY_LOOKBACK_MINUTES=1440
ANOMALY_INTERVAL_MS=300000
